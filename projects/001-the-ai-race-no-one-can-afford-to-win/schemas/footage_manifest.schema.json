{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "footage_manifest.schema.json",
  "title": "FactForge Footage Manifest",
  "description": "Authored by factforge-footage-retrieval. Full provenance record for every scene's chosen visual asset - source, license, and the reasoning behind the choice, not just that it matched keywords. Scenes with no adequate footage candidate (duration, resolution, or general match failure) are flagged fallback_to_ai_visual and picked up by factforge-visual-prompt instead. Current contract supports canonical/reuse/dedup accounting and safe provenance references; signed/private media URLs are forbidden in project-visible metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "scenes",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "asset_type",
          "source",
          "search_queries",
          "license",
          "license_verified_date",
          "attribution_required",
          "attribution_text",
          "reasoning",
          "native_duration_sec",
          "native_resolution",
          "trim_in_sec",
          "trim_out_sec",
          "fallback_to_ai_visual"
        ],
        "additionalProperties": false,
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^scene_[0-9]{3}$"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "video",
              "image"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "pexels",
              "pixabay",
              "coverr",
              "mixkit",
              "ai_fallback"
            ]
          },
          "search_queries": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Executed textual search queries. Minimum accepted evidence is 2 unique executed queries; target production breadth is 3; maximum is 5. Provider attempts, candidate counts, and retries do not count as textual queries."
          },
          "selected_url": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "not": {
                  "pattern": "[?&](token|signature|sig|expires|expires_at|key|apikey|api_key|X-Amz-|Policy|Credential)="
                }
              }
            ],
            "description": "Deprecated/legacy project-visible public source-page or sanitized reference only; not required for new records and never a raw/private/signed download URL."
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_verified_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "attribution_required": {
            "type": "boolean"
          },
          "attribution_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": "string",
            "description": "One-line note on WHY this clip was chosen, not just that it matched keywords - evidence of deliberate editorial choice."
          },
          "native_duration_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "native_resolution": {
            "type": [
              "object",
              "null"
            ],
            "description": "Recorded for human QC visibility, not just used internally during candidate scoring.",
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "trim_in_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "trim_out_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fallback_to_ai_visual": {
            "type": "boolean",
            "description": "True when no candidate passed both the minimum-duration and minimum-resolution hard filters, or no adequate thematic match was found. Looping/freeze-framing a too-short or low-resolution clip is never used to avoid this flag."
          },
          "source_page_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Public provider source page URL/reference; never a signed/private media download URL."
          },
          "asset_role": {
            "type": "string",
            "enum": [
              "canonical",
              "reuse",
              "history",
              "superseded"
            ]
          },
          "asset_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(assets/(footage|images)/)[^?]*$"
          },
          "provenance_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/footage/[^?]+\\.(provenance|reuse\\.provenance)\\.json$"
          },
          "canonical_asset_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/footage/[^?]+\\.mp4$"
          },
          "canonical_provenance_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/footage/[^?]+\\.mp4\\.provenance\\.json$"
          },
          "reuse_of_scene": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^scene_[0-9]{3}$"
          },
          "physical_download_performed": {
            "type": "boolean"
          },
          "duplicate_download_prevented": {
            "type": "boolean"
          },
          "reuse_policy_passed": {
            "type": "boolean"
          },
          "final_edit_approved": {
            "type": "boolean"
          },
          "approved_for_final_edit": {
            "type": "boolean"
          },
          "editorial_quality_approved": {
            "type": "boolean"
          },
          "license_approved": {
            "type": "boolean"
          },
          "actual_resolution": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "expected_resolution": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "rendition_metadata_mismatch": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "legacy_provenance_schema": {
            "type": "boolean"
          },
          "explicit_binding_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "NOT_RECORDED_PRE_SCHEMA",
              "LEGACY_NOT_RECORDED",
              "UNKNOWN"
            ]
          },
          "media_sha_ffprobe_valid": {
            "type": "boolean"
          },
          "selected_rendition_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved_rendition_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "asset_role": {
                  "const": "reuse"
                }
              },
              "required": [
                "asset_role"
              ]
            },
            "then": {
              "required": [
                "reuse_of_scene"
              ],
              "anyOf": [
                {
                  "required": [
                    "canonical_asset_path"
                  ],
                  "properties": {
                    "canonical_asset_path": {
                      "type": "string",
                      "pattern": "^assets/footage/[^?]+\\.mp4$"
                    }
                  }
                },
                {
                  "required": [
                    "asset_path"
                  ],
                  "properties": {
                    "asset_path": {
                      "type": "string",
                      "pattern": "^assets/(footage|images)/[^?]+$"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "generated_at": {
      "type": "string"
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenes_with_final_assets": {
          "type": "integer",
          "minimum": 0
        },
        "effective_mapping_count": {
          "type": "integer",
          "minimum": 0
        },
        "final_edit_approved_scene_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_physical_canonical_assets": {
          "type": "integer",
          "minimum": 0
        },
        "reuse_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_byte_copies_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "active_orphan_media": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined_orphan_media": {
          "type": "integer",
          "minimum": 0
        },
        "editorial_rejected_quarantined": {
          "type": "integer",
          "minimum": 0
        },
        "superseded_history_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
