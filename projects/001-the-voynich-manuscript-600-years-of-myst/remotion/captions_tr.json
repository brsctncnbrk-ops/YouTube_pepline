      "end_frame": 1774
    },
    {
      "text": "daha çok Voynich",
      "start_frame": 1777,
      "end_frame": 1850
    },
    {
      "text": "Elyazması olarak bilinir.",
      "start_frame": 1853,
      "end_frame": 1925
    },
    {
      "text": "Tirşe (vellum)",
      "start_frame": 1928,
      "end_frame": 1976
    },
    {
      "text": "üzerine ciltlenmiş,",
      "start_frame": 1979,
      "end_frame": 2026
    },
    {
      "text": "aşağı yukarı iki",
      "start_frame": 2029,
      "end_frame": 2102
    },
    {
      "text": "yüz kırk sayfadan",
      "start_frame": 2105,
      "end_frame": 2178
    },
    {
      "text": "oluşuyor ve",
      "start_frame": 2181,
      "end_frame": 2228
    },
    {
      "text": "baştan sona, dünyada bilinen",
      "start_frame": 2231,
      "end_frame": 2329
    },
    {
      "text": "hiçbir alfabeyle eşleşmeyen,",
      "start_frame": 2332,
      "end_frame": 2405
    },
    {
      "text": "akıcı, kıvrımlı bir",
      "start_frame": 2408,
      "end_frame": 2481
    },
    {
      "text": "yazıyla dolu.",
      "start_frame": 2484,
      "end_frame": 2531
    },
    {
      "text": "Parmağınızı bir",
      "start_frame": 2534,
      "end_frame": 2582
    },
    {
      "text": "sayfada gezdirin,",
      "start_frame": 2585,
      "end_frame": 2632
    },
    {
      "text": "el yazısı kendinden",
      "start_frame": 2635,
      "end_frame": 2708
    },
    {
      "text": "emin görünür —",
      "start_frame": 2711,
      "end_frame": 2784
    },
    {
      "text": "akıcı, hızlı, tam",
      "start_frame": 2787,
      "end_frame": 2860
    },
    {
      "text": "olarak ne yazdığını",
      "start_frame": 2863,
      "end_frame": 2935
    },
    {
      "text": "bilen birinin",
      "start_frame": 2938,
      "end_frame": 2986
    },
    {
      "text": "eli gibi. Onu",
      "start_frame": 2989,
      "end_frame": 3062
    },
    {
      "text": "bu kadar rahatsız",
      "start_frame": 3065,
      "end_frame": 3137
    },
    {
      "text": "edici yapan",
      "start_frame": 3140,
      "end_frame": 3188
    },
    {
      "text": "şeyin bir kısmı",
      "start_frame": 3191,
      "end_frame": 3264
    },
    {
      "text": "da bu.",
      "start_frame": 3267,
      "end_frame": 3314
    },
    {
      "text": "Bu, rastgele bir",
      "start_frame": 3317,
      "end_frame": 3390
    },
    {
      "text": "karalama değil.",
      "start_frame": 3393,
      "end_frame": 3440
    },
    {
      "text": "Bunu her",
      "start_frame": 3443,
      "end_frame": 3491
    },
    {
      "text": "kim yazdıysa,",
      "start_frame": 3494,
      "end_frame": 3541
    },
    {
      "text": "her tek satırın bir",
      "start_frame": 3544,
      "end_frame": 3642
    },
    {
      "text": "anlamı olduğuna inanıyordu.",
      "start_frame": 3645,
      "end_frame": 3718
    },
    {
      "text": "Açtığınızda, elyazması önce",
      "start_frame": 3721,
      "end_frame": 3812
    },
    {
      "text": "size tanıdık gelmeye",
      "start_frame": 3815,
      "end_frame": 3906
    },
    {
      "text": "başlar.",
      "start_frame": 3909,
      "end_frame": 3937
    },
    {
      "text": "Bitki sayfaları",
      "start_frame": 3940,
      "end_frame": 4000
    },
    {
      "text": "var: kökler,",
      "start_frame": 4003,
      "end_frame": 4062
    },
    {
      "text": "yapraklar, gövdeler,",
      "start_frame": 4065,
      "end_frame": 4125
    },
    {
      "text": "özenle çizilmiş.",
      "start_frame": 4128,
      "end_frame": 4187
    },
    {
      "text": "Ama hiçbiri bilinen",
      "start_frame": 4190,
      "end_frame": 4281
    },
    {
      "text": "bir türle tam",
      "start_frame": 4284,
      "end_frame": 4375
    },
    {
      "text": "olarak eşleşmiyor.",
      "start_frame": 4378,
      "end_frame": 4438
    },
    {
      "text": "Bazıları kimera gibi",
      "start_frame": 4441,
      "end_frame": 4532
    },
    {
      "text": "görünüyor —",
      "start_frame": 4535,
      "end_frame": 4594
    },
    {
      "text": "bir bitkinin yaprağı,",
      "start_frame": 4597,
      "end_frame": 4688
    },
    {
      "text": "başka bir bitkinin",
      "start_frame": 4691,
      "end_frame": 4782
    },
    {
      "text": "köküyle kaynaşmış.",
      "start_frame": 4785,
      "end_frame": 4844
    },
    {
      "text": "Daha ileri gidin,",
      "start_frame": 4847,
      "end_frame": 4938
    },
    {
      "text": "neredeyse simyasal görünen",
      "start_frame": 4941,
      "end_frame": 5032
    },
    {
      "text": "diyagramlara rastlarsınız: birbirine",
      "start_frame": 5035,
      "end_frame": 5126
    },
    {
      "text": "bağlı garip",
      "start_frame": 5129,
      "end_frame": 5189
    },
    {
      "text": "kaplar, borular",
      "start_frame": 5192,
      "end_frame": 5251
    },
    {
      "text": "ve havuzlar,",
      "start_frame": 5254,
      "end_frame": 5314
    },
    {
      "text": "aynı takıntılı",
      "start_frame": 5317,
      "end_frame": 5376
    },
    {
      "text": "özenle çizilmiş.",
      "start_frame": 5379,
      "end_frame": 5439
    },
    {
      "text": "Sonra, elyazmasının kendi",
      "start_frame": 5442,
      "end_frame": 5533
    },
    {
      "text": "görsel mantığında eczacılık",
      "start_frame": 5536,
      "end_frame": 5627
    },
    {
      "text": "olarak etiketlenmiş",
      "start_frame": 5630,
      "end_frame": 5689
    },
    {
      "text": "bir bölüm",
      "start_frame": 5692,
      "end_frame": 5752
    },
    {
      "text": "gelir —",
      "start_frame": 5755,
      "end_frame": 5814
    },
    {
      "text": "sıra sıra",
      "start_frame": 5817,
      "end_frame": 5877
    },
    {
      "text": "etiketlenmiş kavanozlar,",
      "start_frame": 5880,
      "end_frame": 5939
    },
    {
      "text": "kökler ve",
      "start_frame": 5942,
      "end_frame": 6002
    },
    {
      "text": "bitki parçaları,",
      "start_frame": 6005,
      "end_frame": 6065
    },
    {
      "text": "ortaçağ bir eczanenin",
      "start_frame": 6068,
      "end_frame": 6158
    },
    {
      "text": "tarif kitabı gibi",
      "start_frame": 6161,
      "end_frame": 6252
    },
    {
      "text": "düzenlenmiş.",
      "start_frame": 6255,
      "end_frame": 6284
    },
    {
      "text": "Eğer bu bir",
      "start_frame": 6287,
      "end_frame": 6377
    },
    {
      "text": "tıp kitabıysa,",
      "start_frame": 6380,
      "end_frame": 6440
    },
    {
      "text": "kimsenin tanımlayamadığı bitkiler",
      "start_frame": 6443,
      "end_frame": 6534
    },
    {
      "text": "için bir tıp",
      "start_frame": 6537,
      "end_frame": 6628
    },
    {
      "text": "kitabı.",
      "start_frame": 6631,
      "end_frame": 6659
    },
    {
      "text": "Ve tam da",
      "start_frame": 6662,
      "end_frame": 6760
    },
    {
      "text": "onu çözdüğünüzü düşündüğünüz",
      "start_frame": 6763,
      "end_frame": 6862
    },
    {
      "text": "anda,",
      "start_frame": 6865,
      "end_frame": 6895
    },
    {
      "text": "elyazması dikkatini",
      "start_frame": 6898,
      "end_frame": 6963
    },
    {
      "text": "gökyüzüne çevirir.",
      "start_frame": 6966,
      "end_frame": 7030
    },
    {
      "text": "Dairesel diyagramlar",
      "start_frame": 7033,
      "end_frame": 7098
    },
    {
      "text": "sayfaların tamamını",
      "start_frame": 7101,
      "end_frame": 7165
    },
    {
      "text": "kaplar —",
      "start_frame": 7168,
      "end_frame": 7233
    },
    {
      "text": "iç içe halkalar,",
      "start_frame": 7236,
      "end_frame": 7334
    },
    {
      "text": "küçük yıldızlar,",
      "start_frame": 7337,
      "end_frame": 7402
    },
    {
      "text": "burç işareti",
      "start_frame": 7405,
      "end_frame": 7469
    },
    {
      "text": "olabilecek semboller,",
      "start_frame": 7472,
      "end_frame": 7537
    },
    {
      "text": "güneşler, aylar.",
      "start_frame": 7540,
      "end_frame": 7604
    },
    {
      "text": "Astronomik görünüyor.",
      "start_frame": 7607,
      "end_frame": 7672
    },
    {
      "text": "Astrolojik görünüyor. Başka",
      "start_frame": 7675,
      "end_frame": 7773
    },
    {
      "text": "bir deyişle,",
      "start_frame": 7776,
      "end_frame": 7841
    },
    {
      "text": "tam olarak ortaçağ",
      "start_frame": 7844,
      "end_frame": 7942
    },
    {
      "text": "bir bilginin gökyüzünü",
      "start_frame": 7945,
      "end_frame": 8043
    },
    {
      "text": "haritalamak için",
      "start_frame": 8046,
      "end_frame": 8111
    },
