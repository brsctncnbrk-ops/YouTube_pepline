      "start_frame": 8114,
      "end_frame": 8178
    },
    {
      "text": "bir çizelgeye",
      "start_frame": 8181,
      "end_frame": 8246
    },
    {
      "text": "benziyor —",
      "start_frame": 8249,
      "end_frame": 8313
    },
    {
      "text": "ama üzerindeki tek",
      "start_frame": 8316,
      "end_frame": 8415
    },
    {
      "text": "bir etiketi bile",
      "start_frame": 8418,
      "end_frame": 8516
    },
    {
      "text": "okuyamıyoruz.",
      "start_frame": 8519,
      "end_frame": 8550
    },
    {
      "text": "Peki bunu",
      "start_frame": 8553,
      "end_frame": 8613
    },
    {
      "text": "kim yaptı?",
      "start_frame": 8616,
      "end_frame": 8676
    },
    {
      "text": "Bildiğimiz en eski",
      "start_frame": 8679,
      "end_frame": 8771
    },
    {
      "text": "onaylı sahibi,",
      "start_frame": 8774,
      "end_frame": 8834
    },
    {
      "text": "bunun için altı",
      "start_frame": 8837,
      "end_frame": 8928
    },
    {
      "text": "yüz altın duka",
      "start_frame": 8931,
      "end_frame": 9023
    },
    {
      "text": "—",
      "start_frame": 9026,
      "end_frame": 9055
    },
    {
      "text": "küçük bir",
      "start_frame": 9058,
      "end_frame": 9118
    },
    {
      "text": "servet —",
      "start_frame": 9121,
      "end_frame": 9181
    },
    {
      "text": "ödediği söylenen Bohemya",
      "start_frame": 9184,
      "end_frame": 9276
    },
    {
      "text": "İmparatoru İkinci Rudolf'tur;",
      "start_frame": 9279,
      "end_frame": 9370
    },
    {
      "text": "kitabın on üçüncü",
      "start_frame": 9373,
      "end_frame": 9465
    },
    {
      "text": "yüzyıl keşişi ve",
      "start_frame": 9468,
      "end_frame": 9560
    },
    {
      "text": "bilgini Roger",
      "start_frame": 9563,
      "end_frame": 9623
    },
    {
      "text": "Bacon'ın eseri",
      "start_frame": 9626,
      "end_frame": 9686
    },
    {
      "text": "olduğuna inanıyordu.",
      "start_frame": 9689,
      "end_frame": 9749
    },
    {
      "text": "Bu atıf doğrulanamadı.",
      "start_frame": 9752,
      "end_frame": 9844
    },
    {
      "text": "Ama size bir",
      "start_frame": 9847,
      "end_frame": 9939
    },
    {
      "text": "şey anlatıyor: dört",
      "start_frame": 9942,
      "end_frame": 10033
    },
    {
      "text": "yüz yıl",
      "start_frame": 10036,
      "end_frame": 10097
    },
    {
      "text": "önce bile insanlar",
      "start_frame": 10100,
      "end_frame": 10191
    },
    {
      "text": "bu kitaba bakıp",
      "start_frame": 10194,
      "end_frame": 10286
    },
    {
      "text": "bunun bir",
      "start_frame": 10289,
      "end_frame": 10349
    },
    {
      "text": "sahtekârın değil, bir",
      "start_frame": 10352,
      "end_frame": 10444
    },
    {
      "text": "dâhinin eseri olması",
      "start_frame": 10447,
      "end_frame": 10539
    },
    {
      "text": "gerektiğini düşünmüşler.",
      "start_frame": 10542,
      "end_frame": 10602
    },
    {
      "text": "2011'deki radyokarbon tarihlemesi",
      "start_frame": 10605,
      "end_frame": 10697
    },
    {
      "text": "bize daha kesin",
      "start_frame": 10700,
      "end_frame": 10791
    },
    {
      "text": "bir cevap",
      "start_frame": 10794,
      "end_frame": 10854
    },
    {
      "text": "verdi. Tirşenin kendisi",
      "start_frame": 10857,
      "end_frame": 10949
    },
    {
      "text": "1404 ile 1438",
      "start_frame": 10952,
      "end_frame": 11044
    },
    {
      "text": "arasına tarihleniyor.",
      "start_frame": 11047,
      "end_frame": 11107
    },
    {
      "text": "Bunu her",
      "start_frame": 11110,
      "end_frame": 11170
    },
    {
      "text": "kim yazdıysa,",
      "start_frame": 11173,
      "end_frame": 11233
    },
    {
      "text": "1400'lerin başında",
      "start_frame": 11236,
      "end_frame": 11296
    },
    {
      "text": "yazmış —",
      "start_frame": 11299,
      "end_frame": 11360
    },
    {
      "text": "Rudolf'un ona eli",
      "start_frame": 11363,
      "end_frame": 11454
    },
    {
      "text": "değmeden iki yüzyıl",
      "start_frame": 11457,
      "end_frame": 11549
    },
    {
      "text": "önce.",
      "start_frame": 11552,
      "end_frame": 11581
    },
    {
      "text": "Bu da bizi",
      "start_frame": 11584,
      "end_frame": 11675
    },
    {
      "text": "hayatlarını bunu çözmeye",
      "start_frame": 11678,
      "end_frame": 11769
    },
    {
      "text": "adayan insanlara",
      "start_frame": 11772,
      "end_frame": 11832
    },
    {
      "text": "getiriyor. 1940'larda, yaşayan",
      "start_frame": 11835,
      "end_frame": 11927
    },
    {
      "text": "en keskin zekâlı",
      "start_frame": 11930,
      "end_frame": 12021
    },
    {
      "text": "iki şifre",
      "start_frame": 12024,
      "end_frame": 12084
    },
    {
      "text": "çözücü dikkatini elyazmasına",
      "start_frame": 12087,
      "end_frame": 12178
    },
    {
      "text": "çevirdi: William ve",
      "start_frame": 12181,
      "end_frame": 12273
    },
    {
      "text": "Elizabeth Friedman.",
      "start_frame": 12276,
      "end_frame": 12336
    },
    {
      "text": "İkinci Dünya Savaşı",
      "start_frame": 12339,
      "end_frame": 12430
    },
    {
      "text": "sırasında İmparatorluk Japonyası'nın",
      "start_frame": 12433,
      "end_frame": 12525
    },
    {
      "text": "Purple şifresini",
      "start_frame": 12528,
      "end_frame": 12588
    },
    {
      "text": "kırmaya yardım etmiş",
      "start_frame": 12591,
      "end_frame": 12682
    },
    {
      "text": "bir karı-koca ekibiydi",
      "start_frame": 12685,
      "end_frame": 12776
    },
    {
      "text": "bu.",
      "start_frame": 12779,
      "end_frame": 12808
    },
    {
      "text": "Dört yüz yıllık",
      "start_frame": 12811,
      "end_frame": 12902
    },
    {
      "text": "bir bulmacayı biri",
      "start_frame": 12905,
      "end_frame": 12997
    },
    {
      "text": "çözebilecekse,",
      "start_frame": 13000,
      "end_frame": 13028
    },
    {
      "text": "bu onlardı. Bunun",
      "start_frame": 13031,
      "end_frame": 13122
    },
    {
      "text": "için on yıllarını",
      "start_frame": 13125,
      "end_frame": 13217
    },
    {
      "text": "harcadılar.",
      "start_frame": 13220,
      "end_frame": 13248
    },
    {
      "text": "Ve vardıkları sonuç",
      "start_frame": 13251,
      "end_frame": 13343
    },
    {
      "text": "\"bu kırılamaz bir",
      "start_frame": 13346,
      "end_frame": 13437
    },
    {
      "text": "şifre\" değildi.",
      "start_frame": 13440,
      "end_frame": 13500
    },
    {
      "text": "Bundan daha tuhaftı.",
      "start_frame": 13503,
      "end_frame": 13594
    },
    {
      "text": "Metnin, sıfırdan",
      "start_frame": 13597,
      "end_frame": 13657
    },
    {
      "text": "inşa edilmiş,",
      "start_frame": 13660,
      "end_frame": 13720
    },
    {
      "text": "kendi iç",
      "start_frame": 13723,
      "end_frame": 13783
    },
    {
      "text": "kurallarını izleyen,",
      "start_frame": 13786,
      "end_frame": 13846
    },
    {
      "text": "tamamen uydurma bir",
      "start_frame": 13849,
      "end_frame": 13941
    },
    {
      "text": "dil olabileceğine inanmaya",
      "start_frame": 13944,
      "end_frame": 14035
    },
    {
      "text": "başladılar.",
      "start_frame": 14038,
      "end_frame": 14066
    },
    {
      "text": "İşte bu teorinin",
      "start_frame": 14069,
      "end_frame": 14161
    },
    {
      "text": "neden hâlâ ayakta",
      "start_frame": 14164,
      "end_frame": 14255
    },
    {
      "text": "durduğu: elyazmasının",
      "start_frame": 14258,
      "end_frame": 14318
    },
    {
      "text": "alfabesinde yalnızca yaklaşık",
      "start_frame": 14321,
      "end_frame": 14413
    },
    {
      "text": "yirmi beş farklı",
      "start_frame": 14416,
      "end_frame": 14507
    },
    {
      "text": "karakter var",
      "start_frame": 14510,
      "end_frame": 14570
    },
    {
      "text": "ve bunlar gerçek",
      "start_frame": 14573,
      "end_frame": 14664
    },
    {
      "text": "bir şifredeki harfler",
      "start_frame": 14667,
      "end_frame": 14759
    },
    {
      "text": "gibi davranmıyor.",
      "start_frame": 14762,
      "end_frame": 14822
    },
    {
      "text": "Bazı semboller neredeyse",
      "start_frame": 14825,
      "end_frame": 14916
    },
    {
      "text": "yalnızca bir kelimenin",
      "start_frame": 14919,
      "end_frame": 15011
    },
    {
      "text": "başında görünüyor.",
      "start_frame": 15014,
      "end_frame": 15073
    },
    {
      "text": "Diğerleri sona",
      "start_frame": 15076,
      "end_frame": 15136
    },
    {
      "text": "doğru kümeleniyor.",
      "start_frame": 15139,
      "end_frame": 15199
    },
    {
      "text": "İstatistiksel bir analiz",
      "start_frame": 15202,
      "end_frame": 15294
    },
    {
      "text": "yapın —",
      "start_frame": 15297,
      "end_frame": 15357
    },
    {
      "text": "dilbilimcilerin gerçek diller",
      "start_frame": 15360,
      "end_frame": 15451
    },
    {
      "text": "için yaptığı gibi",
      "start_frame": 15454,
      "end_frame": 15545
    },
    {
      "text": "kelime sıklığını",
      "start_frame": 15548,
      "end_frame": 15608
    },
    {
      "text": "çizin — ve",
      "start_frame": 15611,
      "end_frame": 15703
    },
    {
      "text": "örüntüler tutarlı,",
      "start_frame": 15706,
      "end_frame": 15766
    },
    {
      "text": "neredeyse fazla",
      "start_frame": 15769,
      "end_frame": 15829
    },
    {
      "text": "tutarlı çıkıyor.",
      "start_frame": 15832,
      "end_frame": 15892
    },
    {
      "text": "Gerçek şifreler genelde",
      "start_frame": 15895,
      "end_frame": 15986
    },
    {
      "text": "bundan daha dağınık",
      "start_frame": 15989,
      "end_frame": 16080
    },
    {
      "text": "olur.",
      "start_frame": 16083,
      "end_frame": 16112
    },
    {
      "text": "Modern araştırmacılar",
      "start_frame": 16115,
      "end_frame": 16164
    },
    {
      "text": "pes etmedi.",
      "start_frame": 16167,
      "end_frame": 16217
    },
    {
      "text": "Yüksek çözünürlüklü görüntüleme,",
      "start_frame": 16220,
      "end_frame": 16296
    },
    {
      "text": "çok bantlı tarama",
      "start_frame": 16299,
      "end_frame": 16374
    },
    {
      "text": "ve hesaplamalı dilbilim,",
      "start_frame": 16377,
      "end_frame": 16453
    },
    {
      "text": "çıplak gözün kaçırabileceği",
      "start_frame": 16456,
      "end_frame": 16532
    },
    {
      "text": "her şeyi —",
      "start_frame": 16535,
      "end_frame": 16611
    },
    {
      "text": "silik alt çizimler,",
      "start_frame": 16614,
      "end_frame": 16690
    },
    {
      "text": "silinmiş metin,",
      "start_frame": 16693,
      "end_frame": 16742
    },
    {
      "text": "mürekkep bileşimi,",
      "start_frame": 16745,
      "end_frame": 16795
    },
    {
      "text": "ne varsa —",
      "start_frame": 16798,
      "end_frame": 16873
    },
    {
      "text": "bu sayfalarda aramak",
      "start_frame": 16876,
      "end_frame": 16952
    },
    {
      "text": "için kullanıldı.",
      "start_frame": 16955,
      "end_frame": 17005
    },
    {
      "text": "Birkaç yılda bir,",
      "start_frame": 17008,
      "end_frame": 17083
    },
    {
      "text": "biri bir",
      "start_frame": 17086,
      "end_frame": 17136
    },
    {
      "text": "buluş açıklıyor.",
      "start_frame": 17139,
      "end_frame": 17188
    },
    {
      "text": "Şimdiye kadar hiçbiri hakem",
      "start_frame": 17191,
      "end_frame": 17294
    },
    {
      "text": "denetiminden sağ çıkamadı.",
      "start_frame": 17297,
      "end_frame": 17372
    },
    {
      "text": "Bugün, Voynich Elyazması",
      "start_frame": 17375,
      "end_frame": 17458
    },
    {
      "text": "Yale'in Beinecke Nadir",
      "start_frame": 17461,
      "end_frame": 17543
    },
    {
      "text": "Kitaplar ve",
      "start_frame": 17546,
      "end_frame": 17601
    },
    {
      "text": "Elyazmaları Kütüphanesi'nde duruyor;",
      "start_frame": 17604,
      "end_frame": 17686
    },
    {
      "text": "tamamen dijitalleştirilmiş, dünyanın",
      "start_frame": 17689,
      "end_frame": 17772
    },
    {
      "text": "her yerinden herkesin",
      "start_frame": 17775,
      "end_frame": 17857
    },
    {
      "text": "sayfa sayfa,",
      "start_frame": 17860,
      "end_frame": 17914
    },
    {
      "text": "çevrimiçi inceleyebileceği şekilde.",
      "start_frame": 17917,
      "end_frame": 18000
    },
    {
      "text": "Buzağı derisi",
      "start_frame": 18003,
      "end_frame": 18057
    },
    {
      "text": "üzerine mürekkeple,",
      "start_frame": 18060,
      "end_frame": 18114
    },
    {
      "text": "kimliği hiçbir zaman",
      "start_frame": 18117,
      "end_frame": 18200
    },
    {
      "text": "belirlenememiş biri tarafından,",
      "start_frame": 18203,
      "end_frame": 18285
    },
    {
      "text": "kimsenin çözemediği bir",
      "start_frame": 18288,
      "end_frame": 18371
    },
    {
      "text": "yazıyla yazılışının üzerinden",
      "start_frame": 18374,
      "end_frame": 18456
    },
    {
      "text": "altı yüz",
      "start_frame": 18459,
      "end_frame": 18513
    },
    {
      "text": "yıl geçti —",
      "start_frame": 18516,
      "end_frame": 18599
    },
    {
      "text": "dünyanın en gizemli",
      "start_frame": 18602,
      "end_frame": 18685
    },
    {
      "text": "kitabı hâlâ tam",
      "start_frame": 18688,
      "end_frame": 18770
    },
    {
      "text": "olarak bu.",
      "start_frame": 18773,
      "end_frame": 18827
    },
    {
      "text": "Tahmin etmeniz",
      "start_frame": 18830,
      "end_frame": 18884
    },
    {
      "text": "gerekseydi —",
      "start_frame": 18887,
      "end_frame": 18941
    },
    {
      "text": "gerçek bir",
      "start_frame": 18944,
      "end_frame": 18998
    },
    {
      "text": "dil mi,",
      "start_frame": 19001,
      "end_frame": 19055
    },
    {
      "text": "uydurma bir",
      "start_frame": 19058,
      "end_frame": 19112
    },
    {
      "text": "dil mi,",
      "start_frame": 19115,
      "end_frame": 19170
    },
    {
      "text": "karmaşık bir",
      "start_frame": 19173,
      "end_frame": 19227
    },
    {
      "text": "şifre mi,",
      "start_frame": 19230,
      "end_frame": 19284
    },
    {
      "text": "yoksa altı yüz",
      "start_frame": 19287,
      "end_frame": 19369
    },
    {
      "text": "yıllık bir aldatmaca",
      "start_frame": 19372,
      "end_frame": 19455
    },
    {
      "text": "mı —",
      "start_frame": 19458,
      "end_frame": 19512
    },
    {
      "text": "hangi teoriye bahis",
      "start_frame": 19515,
      "end_frame": 19597
    },
    {
      "text": "oynardınız? Yorumlarda söyleyin.",
      "start_frame": 19600,
      "end_frame": 19683
    }
  ]
}
