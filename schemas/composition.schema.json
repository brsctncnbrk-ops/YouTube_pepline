{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "composition.schema.json",
  "title": "FactForge Remotion Composition",
  "description": "Validates the merged shape of remotion/composition.json + scene_config.json + asset_map.json. All asset path fields are regex-constrained to forbid absolute paths, drive letters, home-dir shorthand, and parent-directory traversal.",
  "type": "object",
  "required": ["fps", "width", "height", "duration_frames", "audio_asset", "scenes", "asset_map", "render"],
  "additionalProperties": false,
  "definitions": {
    "relativeAudioPath": {
      "type": "string",
      "pattern": "^assets/audio/final_voice\\.mp3$"
    },
    "relativeImagePath": {
      "type": "string",
      "pattern": "^assets/images/scene_[0-9]{3}\\.png$"
    }
  },
  "properties": {
    "fps": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "duration_frames": { "type": "integer", "minimum": 1 },
    "audio_asset": { "$ref": "#/definitions/relativeAudioPath" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "start_frame", "end_frame", "image_asset", "camera_motion", "transition_in", "transition_out"],
        "additionalProperties": false,
        "properties": {
          "scene_id": { "type": "string", "pattern": "^scene_[0-9]{3}$" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 0 },
          "image_asset": { "$ref": "#/definitions/relativeImagePath" },
          "camera_motion": {
            "type": "object",
            "required": ["type", "params"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["zoom_in", "zoom_out", "pan_left", "pan_right", "pan_up", "pan_down", "static"]
              },
              "params": { "type": "object" }
            }
          },
          "text_overlay": { "type": ["string", "null"] },
          "transition_in": {
            "type": "string",
            "enum": ["fade", "dissolve", "cut", "wipe", "slide", "light_flash", "blur", "zoom_through"]
          },
          "transition_out": {
            "type": "string",
            "enum": ["fade", "dissolve", "cut", "wipe", "slide", "light_flash", "blur", "zoom_through"]
          },
          "overlay_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "params"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["glow", "noise", "vignette", "particles"]
                },
                "params": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "asset_map": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["image", "audio_offset_sec"],
        "additionalProperties": false,
        "properties": {
          "image": { "$ref": "#/definitions/relativeImagePath" },
          "audio_offset_sec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["codec", "crf", "output_filename"],
      "additionalProperties": false,
      "properties": {
        "codec": { "type": "string" },
        "crf": { "type": "number" },
        "output_filename": { "type": "string", "pattern": "^final_video\\.mp4$" }
      }
    }
  }
}
