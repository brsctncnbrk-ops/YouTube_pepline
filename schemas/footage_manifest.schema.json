{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "footage_manifest.schema.json",
  "title": "FactForge Footage Manifest",
  "description": "Authored by factforge-footage-retrieval. Full provenance record for every scene's chosen visual asset - source, license, and the reasoning behind the choice, not just that it matched keywords. Scenes with no adequate footage candidate (duration, resolution, or general match failure) are flagged fallback_to_ai_visual and picked up by factforge-visual-prompt instead.",
  "type": "object",
  "required": ["schema_version", "project_id", "scenes", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "asset_type",
          "source",
          "search_queries",
          "selected_url",
          "license",
          "license_verified_date",
          "attribution_required",
          "attribution_text",
          "reasoning",
          "native_duration_sec",
          "native_resolution",
          "trim_in_sec",
          "trim_out_sec",
          "fallback_to_ai_visual"
        ],
        "additionalProperties": false,
        "properties": {
          "scene_id": { "type": "string", "pattern": "^scene_[0-9]{3}$" },
          "asset_type": { "type": "string", "enum": ["video", "image"] },
          "source": { "type": "string", "enum": ["pexels", "pixabay", "coverr", "mixkit", "ai_fallback"] },
          "search_queries": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
          "selected_url": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "license_verified_date": { "type": ["string", "null"] },
          "attribution_required": { "type": "boolean" },
          "attribution_text": { "type": ["string", "null"] },
          "reasoning": {
            "type": "string",
            "description": "One-line note on WHY this clip was chosen, not just that it matched keywords - evidence of deliberate editorial choice."
          },
          "native_duration_sec": { "type": ["number", "null"], "minimum": 0 },
          "native_resolution": {
            "type": ["object", "null"],
            "description": "Recorded for human QC visibility, not just used internally during candidate scoring.",
            "required": ["width", "height"],
            "additionalProperties": false,
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "trim_in_sec": { "type": ["number", "null"], "minimum": 0 },
          "trim_out_sec": { "type": ["number", "null"], "minimum": 0 },
          "fallback_to_ai_visual": {
            "type": "boolean",
            "description": "True when no candidate passed both the minimum-duration and minimum-resolution hard filters, or no adequate thematic match was found. Looping/freeze-framing a too-short or low-resolution clip is never used to avoid this flag."
          }
        }
      }
    },
    "generated_at": { "type": "string" }
  }
}
