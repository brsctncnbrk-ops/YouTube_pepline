{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orvyq_production_plan.schema.json",
  "title": "ORVYQ Canonical Full-Duration Production Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "status",
    "fps",
    "duration_frames",
    "proof",
    "quality_policy",
    "sections",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "art_direction": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "duration_frames",
        "minimum_human_score"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "prefix"
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "narration_limit_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_human_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "quality_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "max_shot_seconds",
        "generic_stock_fraction_max",
        "evidence_and_archive_fraction_min",
        "full_screen_graphic_fraction_max",
        "max_uses_per_source",
        "automatic_asset_fallback_forbidden"
      ],
      "properties": {
        "max_shot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 12
        },
        "generic_stock_fraction_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_and_archive_fraction_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "full_screen_graphic_fraction_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_uses_per_source": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "minimum_overlay_font_px": {
          "type": "number",
          "minimum": 24
        },
        "automatic_asset_fallback_forbidden": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "section_id",
          "start_frame",
          "end_frame",
          "dramatic_function",
          "music_state"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "dramatic_function": {
            "type": "string",
            "minLength": 12
          },
          "music_state": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "shot_id",
          "scene_id",
          "section_id",
          "start_frame",
          "end_frame",
          "claim_id",
          "visual_role",
          "editorial_purpose",
          "asset_type",
          "generic_stock",
          "transition_in",
          "transition_out"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "pattern": "^shot_[0-9]{3,4}$"
          },
          "scene_id": {
            "type": "string",
            "pattern": "^scene_[0-9]{3}$"
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "visual_role": {
            "type": "string",
            "enum": [
              "evidence",
              "archive",
              "context",
              "metaphor",
              "graphic"
            ]
          },
          "editorial_purpose": {
            "type": "string",
            "minLength": 18
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "footage",
              "ai_fallback",
              "evidence",
              "graphic"
            ]
          },
          "generic_stock": {
            "type": "boolean"
          },
          "transition_in": {
            "type": "string",
            "enum": [
              "cut",
              "fade",
              "dissolve"
            ]
          },
          "transition_out": {
            "type": "string",
            "enum": [
              "cut",
              "fade",
              "dissolve"
            ]
          },
          "video_asset": {
            "type": "string",
            "pattern": "^assets/footage/[^/].+"
          },
          "image_asset": {
            "type": "string",
            "pattern": "^assets/images/[^/].+"
          },
          "trim_in_sec": {
            "type": "number",
            "minimum": 0
          },
          "trim_out_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "camera_motion": {
            "type": "object",
            "additionalProperties": true
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          },
          "graphic": {
            "type": "object",
            "additionalProperties": true
          },
          "motif": {
            "type": [
              "string",
              "null"
            ]
          },
          "editorial_overlay": {
            "type": [
              "object",
              "null"
            ]
          },
          "emphasis_card": {
            "type": [
              "object",
              "null"
            ]
          },
          "sound_cue": {
            "type": [
              "object",
              "string",
              "null"
            ]
          },
          "text_overlay": {
            "type": [
              "string",
              "null"
            ]
          },
          "section_bridge": {
            "type": "boolean"
          },
          "synthesis_evidence": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
