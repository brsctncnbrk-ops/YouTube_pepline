{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storyboard.schema.json",
  "title": "FactForge Storyboard",
  "type": "object",
  "required": [
    "project_id",
    "target_duration_sec",
    "total_duration_sec",
    "scene_count",
    "scenes",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string" },
    "target_duration_sec": { "type": "integer", "minimum": 1 },
    "total_duration_sec": { "type": "number", "minimum": 0 },
    "scene_count": { "type": "integer", "minimum": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "start_sec",
          "end_sec",
          "duration_sec",
          "purpose",
          "visual_need",
          "on_screen_text",
          "transition_in",
          "transition_out",
          "voice_line_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "scene_id": { "type": "string", "pattern": "^scene_[0-9]{3}$" },
          "start_sec": { "type": "number", "minimum": 0 },
          "end_sec": { "type": "number", "minimum": 0 },
          "duration_sec": { "type": "number", "minimum": 0 },
          "purpose": { "type": "string" },
          "visual_need": { "type": "string" },
          "on_screen_text": { "type": ["string", "null"] },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "voice_line_ref": { "type": "string" }
        }
      }
    },
    "generated_at": { "type": "string" }
  }
}
