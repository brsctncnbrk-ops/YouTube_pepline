{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orvyq_proof_approval.schema.json",
  "title": "ORVYQ Human Proof Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "approved",
    "review_type",
    "human_score",
    "proof_run_id",
    "render_source_sha",
    "production_plan_sha256",
    "approved_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "approved": { "type": "boolean", "const": true },
    "review_type": { "type": "string", "const": "human_rendered_video_review" },
    "human_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "proof_run_id": { "type": ["string", "integer"] },
    "render_source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "production_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approved_at": { "type": "string", "format": "date-time" },
    "review_notes": { "type": "string" }
  }
}
