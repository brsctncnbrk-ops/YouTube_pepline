{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "packaging.schema.json",
  "title": "FactForge YouTube Packaging",
  "type": "object",
  "required": ["schema_version", "project_id", "titles", "description", "tags", "thumbnail_concepts", "chapters", "pinned_comment", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "project_id": { "type": "string" },
    "titles": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "thumbnail_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["concept", "text_overlay", "notes"],
        "additionalProperties": false,
        "properties": {
          "concept": { "type": "string" },
          "text_overlay": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "label"],
        "additionalProperties": false,
        "properties": {
          "timestamp": { "type": "string", "pattern": "^([0-9]{1,2}:)?[0-9]{1,2}:[0-9]{2}$" },
          "label": { "type": "string" }
        }
      }
    },
    "pinned_comment": { "type": "string" },
    "footage_attribution": {
      "type": "array",
      "description": "Attribution lines sourced from footage/footage_manifest.json for clips whose license requires credit. Optional - not every project has attribution-required footage.",
      "items": { "type": "string" }
    },
    "generated_at": { "type": "string" }
  }
}
